# Copy to .env (git-ignored) and fill ONE provider. Never commit .env.
LLM_PROVIDER=openai          # openai | gemini | openrouter | anthropic
LLM_MODEL=gpt-4o-mini        # any model with tool calling
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# Optional: USD per 1M tokens for cost estimates if the model is not in src/llm.py DEFAULT_PRICES
# LLM_PRICE_IN=
# LLM_PRICE_OUT=
# Optional: location of the Day 6 repo (Chroma index + chunks)
# DAY6_DIR=/path/to/K5-L3-Day06-DataIngestionEngineering-main
# Advanced challenge (advanced/): embedding provider for the MCS 2024 index
#   openai = text-embedding-3-small (paid), gemini = gemini-embedding-001, local = multilingual-e5-small (free, used for test2)
# EMB_PROVIDER=local
